# Git Line Endings and Attributes Configuration
# Enforce consistent line endings (LF) across operating systems (Linux, macOS, Windows)
# and avoid diff pollution from CRLF/LF discrepancies.

# Set default behavior: normalize all text files to LF in repo
* text=auto eol=lf

# Code and Configuration (enforce LF)
*.py text eol=lf
*.go text eol=lf
*.cs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.dbml text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.ini text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
makefile text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Shell scripts (must have LF to execute on Unix/Linux)
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.ps1 text eol=lf

# Windows-specific scripts (must have CRLF for command interpreter)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (do not touch or convert line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.gz binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

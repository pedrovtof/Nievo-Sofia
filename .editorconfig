# EditorConfig helps maintain consistent coding styles across various editors and IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.cs]
indent_size = 4

[*.{c,cpp,h,hpp}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab

[makefile]
indent_style = tab
